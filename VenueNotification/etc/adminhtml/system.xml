<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>

        <tab id="ueg" translate="label" sortOrder="100">
            <label>UEG</label>
        </tab>

        <section id="apibase" translate="label" type="text" sortOrder="310"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Ueg Watchlist Venue</label>
            <tab>ueg</tab>
            <resource>Ueg_ApiBase::configuration</resource>
            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Venue Traders</label>
                <field id="dynamic_field" translate="label" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Dynamic Fields (JSON)</label>
                    <comment>Map venue to trader role</comment>
                </field>
            </group>
        </section>

        <section id="venuenotification" translate="label" sortOrder="200"
                 showInDefault="1" showInWebsite="0" showInStore="0">
            <label>Venue Notification</label>
            <tab>ueg</tab>
            <resource>Ueg_VenueNotification::config</resource>

            <!-- ================= WHOLESALER ================= -->
            <group id="wholesaler" translate="label" sortOrder="10" showInDefault="1">
                <label>Wholesaler Notification</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1">
                    <label>Enable Wholesaler Notification</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="dismiss_days" translate="label" type="text" sortOrder="20" showInDefault="1">
                    <label>Default Dismiss Days</label>
                    <validate>validate-number validate-zero-or-greater</validate>
                </field>
            </group>

            <!-- ================= RETAILER ================= -->
            <group id="retailer" translate="label" sortOrder="20" showInDefault="1">
                <label>Retailer Notification</label>

                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1">
                    <label>Enable Retailer Notification</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <!-- ✅ 1) RELATION: less than / greater than -->
                <field id="relation" translate="label" type="select" sortOrder="20" showInDefault="1">
                    <label>Relation</label>
                    <source_model>Ueg\VenueNotification\Model\Config\Source\Relation</source_model>
                    <comment>Compare MSG price to cheapest retailer using less than or greater than</comment>
                </field>

                <!-- ✅ 2) THRESHOLD TYPE: dollar / percentage -->
                <field id="threshold_type" translate="label" type="select" sortOrder="30" showInDefault="1">
                    <label>Threshold Type</label>
                    <source_model>Ueg\VenueNotification\Model\Config\Source\ThresholdType</source_model>
                    <comment>Apply threshold as dollar amount or percentage</comment>
                </field>

                <!-- ✅ 3) THRESHOLD VALUE: 10 -->
                <field id="threshold_value" translate="label" type="text" sortOrder="40" showInDefault="1">
                    <label>Threshold Value</label>
                    <validate>validate-number validate-zero-or-greater</validate>
                    <comment>Numeric value e.g. 10</comment>
                </field>

                <field id="dismiss_days" translate="label" type="text" sortOrder="50" showInDefault="1">
                    <label>Default Dismiss Days</label>
                    <validate>validate-number validate-zero-or-greater</validate>
                </field>
            </group>

            <!-- ================= GENERAL ================= -->
            <group id="general" translate="label" sortOrder="30" showInDefault="1">
                <label>General</label>
                <field id="cron_interval_hours" translate="label" type="text" sortOrder="10" showInDefault="1">
                    <label>Cron Interval (hours)</label>
                    <comment>Default 6</comment>
                    <validate>validate-number validate-zero-or-greater</validate>
                </field>
                <field id="email_to" translate="label" type="text" sortOrder="20" showInDefault="1">
                    <label>Email To</label>
                    <comment>Comma separated a@x.com,b@x.com</comment>
                    <validate>validate-emails</validate>
                </field>
                <field id="email_sender" translate="label" type="select" sortOrder="30" showInDefault="1">
                    <label>Email Sender</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Identity</source_model>
                </field>
                <field id="email_template" translate="label" type="select" sortOrder="40" showInDefault="1">
                    <label>Email Template</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                </field>
            </group>

        </section>
    </system>
</config>